{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IP Monitor",
  "version": "0.2.0",
  "identifier": "com.ipmonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IP Monitor",
        "width": 471,
        "height": 323,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "backgroundColor": "#00000000",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Shows the IP address your requests actually leave from.",
    "longDescription": "A floating card that reports the IPv4 and IPv6 exit address of the selected detection mode: direct, the Windows system proxy, or a custom HTTP/SOCKS5 proxy.",
    "publisher": "IP Monitor",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
